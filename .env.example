# Copy to .env.local. Values for the shared dev setup are in Vercel: `vercel env pull .env.local`.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_REVALIDATE_SECRET=
# Read token (Viewer) del progetto Sanity: il dataset limita la lettura pubblica
# di alcuni tipi (es. caseStudy). Senza, /lavori resta vuota anche in dev.
SANITY_API_READ_TOKEN=
# Write token. Serve IN PRODUZIONE (Vercel) a form contatti e registro consensi:
# token dedicato col minimo privilegio. Per gli importer usare un token separato
# solo in locale: gli script di import/seed (es. import-case-studies.mjs della
# skill use-case-publish) leggono questa stessa variabile da .env.local, quindi
# in locale qui va il token Editor, diverso da quello messo su Vercel.
SANITY_API_WRITE_TOKEN=

# Resend: notifica email di ogni richiesta del form contatti. Senza chiave il
# lead viene salvato su Sanity ma nessuno riceve la mail.
RESEND_API_KEY=
# Mittente su un dominio verificato in Resend (es. "flylabs <noreply@flylabs.ai>").
# Senza, Resend usa onboarding@resend.dev, che consegna solo al proprietario dell'account.
RESEND_FROM=
# Destinatario delle notifiche.
RESEND_TO=info@flylabs.ai

# Segreto per l'hash degli IP (HMAC-SHA256) nel rate limit del form e nel
# registro consensi. Stringa casuale lunga (es. `openssl rand -hex 32`), solo
# server, su Vercel in Production. Se manca si usa SHA-256 senza segreto.
IP_HASH_SECRET=

# Google Analytics 4 Measurement ID (es. G-XXXXXXXXXX). Caricato solo dopo consenso "Statistiche".
NEXT_PUBLIC_GA_ID=
